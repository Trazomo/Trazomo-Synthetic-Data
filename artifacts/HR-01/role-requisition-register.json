  "competency_library": [
    {
      "competency_id": "CMP-01",
      "name": "Structured problem solving",
      "definition": "Breaks an unfamiliar problem into parts, states the assumptions being made, and works to an answer that can be defended to someone who was not in the room."
    },
    {
      "competency_id": "CMP-02",
      "name": "Technical depth",
      "definition": "Explains how something they built actually works, including the parts that did not work first time, without retreating into vocabulary."
    },
    {
      "competency_id": "CMP-03",
      "name": "System design judgment",
      "definition": "Chooses between designs by naming the constraint each one is paying for, and can say what would have to change for the other choice to win."
    },
    {
      "competency_id": "CMP-04",
      "name": "Written communication",
      "definition": "Writes so that a reader outside the immediate team can act on the text without a follow up conversation."
    },
    {
      "competency_id": "CMP-05",
      "name": "Collaboration across teams",
      "definition": "Moves work forward with people who do not report to them and who hold different priorities, without escalating as a first step."
    },
    {
      "competency_id": "CMP-06",
      "name": "Customer empathy",
      "definition": "Describes the person on the other side of the product in their own terms rather than in internal terms, and lets that description change the work."
    },
    {
      "competency_id": "CMP-07",
      "name": "Ownership and follow through",
      "definition": "Carries a piece of work past the interesting part to the point where someone else can rely on it unattended."
    },
    {
      "competency_id": "CMP-08",
      "name": "Data literacy",
      "definition": "Reads a table or a chart for what it does not say as well as for what it does, and states the limits of the reading."
    },
    {
      "competency_id": "CMP-09",
      "name": "Coaching and feedback",
      "definition": "Gives specific, timely feedback that names behavior and effect rather than character, and receives it the same way."
    },
    {
      "competency_id": "CMP-10",
      "name": "Prioritization under constraint",
      "definition": "Says what will not be done, and why, when there is more demand than capacity, and revisits that choice when the constraint moves."
    },
    {
      "competency_id": "CMP-11",
      "name": "Commercial judgment",
      "definition": "Connects a piece of work to the account, the renewal or the pipeline it serves, and can say what would make the connection false."
    },
    {
      "competency_id": "CMP-12",
      "name": "Operational rigor",
      "definition": "Builds the checks, handovers and records that let a process survive the absence of the person who designed it."
    }
  ],
